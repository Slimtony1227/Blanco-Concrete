{
  "name": "blanco-site",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "start": "node scripts/start-local.mjs",
    "dev:local": "node scripts/start-local.mjs",
    "db:check": "wrangler d1 execute blanco-reviews-local --config wrangler.local.jsonc --local --command \"SELECT count(*) AS reviews FROM reviews\"",
    "test:reviews": "node --test scripts/reviews.test.mjs",
    "test:access": "node --test scripts/access.test.mjs",
    "test:admin": "node --test scripts/admin-requests.test.mjs",
    "test:spam": "node --test scripts/spam.test.mjs",
    "dev": "vite --host",
    "build": "vite build && node scripts/build-metadata.mjs",
    "lint": "oxlint",
    "preview": "vite preview --host"
  },
  "dependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "jose": "6.2.13",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router-dom": "^7.18.4"
  },
  "devDependencies": {
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "autoprefixer": "^10.6.1",
    "oxlint": "^1.81.0",
    "postcss": "^8.5.28",
    "tailwindcss": "^4.3.3",
    "vite": "^8.3.0",
    "wrangler": "4.147.0"
  }
}
